# Public site URL used in social share links (optional).
# Defaults to https://example-quiz.app if unset.
VITE_APP_URL=https://quiz.pixfan.fr

# Enable remote high scores (requires Cloudflare D1/KV backend)
# Set to "true" to enable cross-device high scores
VITE_ENABLE_REMOTE_SCORES=false

# Admin PIN — two layers (do not commit a real PIN):
#
# 1) SPA unlock (#/admin): VITE_ADMIN_PIN at *build* time
#    - Local DEV: if unset, defaults to "pixfan"
#    - Production: GitHub Actions secret VITE_ADMIN_PIN (wired in ci-cd.yml)
#      and/or Cloudflare Pages build env, then redeploy
#
# 2) Pages Functions (/api/admin/*): runtime env on the Pages *project*
#    - Prefer ADMIN_PIN (Functions-only, clear naming)
#    - VITE_ADMIN_PIN is also accepted if already set on the project
#    - Without a runtime value, analytics/reports return 503
#      "Admin PIN not configured on Pages Functions…"
#
# Cloudflare Pages → Settings → Environment variables → Production:
#   VITE_ADMIN_PIN=<same value as SPA/CI>   # build + runtime OK if set on project
#   ADMIN_PIN=<same value>                  # optional but preferred for Functions
# Then redeploy (or wait for next CI deploy) so Functions pick up the binding.
#
# VITE_ADMIN_PIN=change-me
# ADMIN_PIN=change-me
