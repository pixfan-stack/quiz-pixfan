# SEO assets — explicit 200 so a missing file races to a rewrite target,
# not the SPA catch-all (which would return index.html as application/xml false-positive).
/sitemap.xml    /sitemap.xml    200
/robots.txt     /robots.txt     200

# Path locales (vague 1.99) — trailing slash only.
# IMPORTANT: never put query-string home redirects here — CF Pages treats a
# rule like "slash + lang query → /en/" as source "/" and 301s FR home to EN
# (live incident after #147). Home lang query stays dual-soft (sniff + i18n).
/en    /en/    301
/es    /es/    301
/de    /de/    301

# Guides under locale prefix (vague 1.99 / 1.103 hotfix).
# Hubs + scolaires shells are REAL files at /{en,es,de}/guides[/scolaires]/index.html
# (baked at build). Do NOT use /xx/guides/* splat — it matches the hub itself and
# proxies to FR /guides/ (live bug after #152: /en/guides/ stayed lang=fr).
# Topics use :slug (single segment, no trailing slash). Fiche is explicit.
/en/guides    /en/guides/    301
/es/guides    /es/guides/    301
/de/guides    /de/guides/    301
/en/guides/scolaires    /en/guides/scolaires/    301
/es/guides/scolaires    /es/guides/scolaires/    301
/de/guides/scolaires    /de/guides/scolaires/    301
/en/guides/scolaires/fiche-seance.html    /guides/scolaires/fiche-seance.html    200
/es/guides/scolaires/fiche-seance.html    /guides/scolaires/fiche-seance.html    200
/de/guides/scolaires/fiche-seance.html    /guides/scolaires/fiche-seance.html    200
/en/guides/:slug    /guides/:slug    200
/es/guides/:slug    /guides/:slug    200
/de/guides/:slug    /guides/:slug    200

# Partenaires (vague 1.102 / 1.104). Locale shells are REAL files at
# /{en,es,de}/partenaires/index.html (baked at build). Do NOT 200-rewrite to
# /partenaires/index.html — live CF ignored that rule and fell through to the
# SPA catch-all, injecting homepage FAQ JSON-LD (QP-291).
/partenaires    /partenaires/    301
/en/partenaires    /en/partenaires/    301
/es/partenaires    /es/partenaires/    301
/de/partenaires    /de/partenaires/    301

# Share landings under locale prefix (vague 1.105 / QP-293).
# Do NOT 200-proxy /xx/s/:id → /s/:id — CF Pages proxying only resolves
# static assets (docs: redirects apply to static asset responses). Destination
# /s/:id is a Pages Function, so the 1.104 rewrite was ignored and the SPA
# catch-all injected homepage FAQ JSON-LD (live residual after #154).
# Locale sessions are served by Functions at functions/{en,es,de}/s/[id].ts.

# Cloudflare Pages SPA fallback (safe even without client-side routes)
# Real files at /en/index.html /es/index.html /de/index.html (+ partenaires
# shells) win over this catch-all. Functions match before static/SPA.
/*    /index.html   200
